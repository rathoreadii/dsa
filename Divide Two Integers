class Solution {
public:
    int divide(int dividend, int divisor) {
        if(dividend == INT_MIN && divisor == -1)
            return INT_MAX;
        
        bool neg= (dividend < 0) ^ (divisor < 0);

        long long dvd = llabs((long long) dividend);
        long long dvs = llabs((long long) divisor);

        long long q = 0;

        while(dvd >= dvs){
            long long tmp = dvs;
            long long mul = 1;

            while((tmp << 1) <= dvd){
                tmp <<= 1;
                mul <<= 1;
            }

            dvd -= tmp;
            q += mul;
        }

        if(neg)
            q = -q;
        
        return (int)q;
    }
};
