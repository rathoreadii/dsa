class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int cnt= 0;
        int ele;
        int n = nums.size();

        for(int i= 0; i< n; i++){
            if(cnt == 0){
                ele = nums[i];
                cnt = 1;
            } 
            else if (ele == nums[i])
                cnt++;
            else
                cnt--;
        }

        int c= 0;
        for(auto &i: nums)
            if(i == ele)
                c++;
        
        if(c > n/2)
            return ele;
        
        return -1;
    }
};
